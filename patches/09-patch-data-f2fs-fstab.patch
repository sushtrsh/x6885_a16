 // Generated vendor fstab belongs on writable recovery tmpfs.
 std::string additional_fstab = "/tmp/additional.fstab";
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+// The stock vendor fstab lists /data twice: f2fs first, then an ext4 fallback.
+// OrangeFox lets the later line win, so userdata was treated as ext4 and a
+// wipe/format from recovery could produce the wrong filesystem. When an f2fs
+// /data entry exists, drop the ext4 fallback from the generated copy.
+static void Drop_Ext4_Data_Fallback(const std::string& path) {
+	std::ifstream in(path);
+	if (!in.is_open())
+		return;
+	std::vector<std::string> lines;
+	std::string line;
+	bool has_f2fs_data = false;
+	while (std::getline(in, line)) {
+		lines.push_back(line);
+		std::istringstream ss(line);
+		std::string src, mnt, fs;
+		if ((ss >> src >> mnt >> fs) && src[0] != '#' && mnt == "/data" && fs == "f2fs")
+			has_f2fs_data = true;
+	}
+	in.close();
+	if (!has_f2fs_data)
+		return;
+	std::ofstream out(path, std::ios::trunc);
+	if (!out.is_open())
+		return;
+	for (const auto& l : lines) {
+		std::istringstream ss(l);
+		std::string src, mnt, fs;
+		if ((ss >> src >> mnt >> fs) && src[0] != '#' && mnt == "/data" && fs == "ext4") {
+			LOGINFO("Dropping ext4 /data fallback from additional fstab\n");
+			continue;
+		}
+		out << l << "\n";
+	}
+}
 
 TWPartitionManager::TWPartitionManager(void) {
 	mtp_was_enabled = false;
