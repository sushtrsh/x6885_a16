# Infinix X6885 (MT6789) - TWRP/OrangeFox fstab
# Derived from the stock first_stage_ramdisk/fstab.mt6789 shipped in vendor_boot.
# <mount point>  <fstype>  <device>  [<device2>]  <flags>

# --- Logical partitions inside super (A/B, slot-selected) ---
/system_root   erofs   system       flags=display="System";logical;slotselect
/system_root   ext4    system       flags=display="System";logical;slotselect
/system_ext    erofs   system_ext   flags=display="System Ext";logical;slotselect
/system_ext    ext4    system_ext   flags=display="System Ext";logical;slotselect
/vendor        erofs   vendor       flags=display="Vendor";logical;slotselect
/vendor        ext4    vendor       flags=display="Vendor";logical;slotselect
/product       erofs   product      flags=display="Product";logical;slotselect
/product       ext4    product      flags=display="Product";logical;slotselect
/odm           erofs   odm          flags=display="ODM";logical;slotselect
/odm           ext4    odm          flags=display="ODM";logical;slotselect
/vendor_dlkm   erofs   vendor_dlkm  flags=display="Vendor DLKM";logical;slotselect
/vendor_dlkm   ext4    vendor_dlkm  flags=display="Vendor DLKM";logical;slotselect
/odm_dlkm      erofs   odm_dlkm     flags=display="ODM DLKM";logical;slotselect
/odm_dlkm      ext4    odm_dlkm     flags=display="ODM DLKM";logical;slotselect
/system_dlkm   erofs   system_dlkm  flags=display="System DLKM";logical;slotselect
/system_dlkm   ext4    system_dlkm  flags=display="System DLKM";logical;slotselect

# --- Boot-chain images (flash targets) ---
/boot          emmc    /dev/block/by-name/boot          flags=display="Boot";backup=1;flashimg=1;slotselect
/vendor_boot   emmc    /dev/block/by-name/vendor_boot   flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/init_boot     emmc    /dev/block/by-name/init_boot     flags=display="Init Boot";backup=1;flashimg=1;slotselect
/dtbo          emmc    /dev/block/by-name/dtbo          flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta        emmc    /dev/block/by-name/vbmeta        flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system emmc    /dev/block/by-name/vbmeta_system flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor emmc    /dev/block/by-name/vbmeta_vendor flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect

# --- Data / metadata ---
/metadata      ext4    /dev/block/by-name/metadata      flags=display="Metadata"
/data          f2fs    /dev/block/by-name/userdata      flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption;display="Data";wipeingui;backup=1
/data          ext4    /dev/block/by-name/userdata      flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption;display="Data";wipeingui;backup=1

# --- MediaTek calibration / identity partitions (back these up before experimenting!) ---
/persist       ext4    /dev/block/by-name/persist       flags=display="Persist";backup=1
/nvdata        ext4    /dev/block/by-name/nvdata        flags=display="NVData";backup=1
/nvcfg         ext4    /dev/block/by-name/nvcfg         flags=display="NVCfg";backup=1
/protect_f     ext4    /dev/block/by-name/protect1      flags=display="Protect F";backup=1
/protect_s     ext4    /dev/block/by-name/protect2      flags=display="Protect S";backup=1
/nvram         emmc    /dev/block/by-name/nvram         flags=display="NVRAM";backup=1;flashimg=1
/proinfo       emmc    /dev/block/by-name/proinfo       flags=display="ProInfo";backup=1;flashimg=1
/persistent    emmc    /dev/block/by-name/frp           flags=display="FRP";backup=1
/misc          emmc    /dev/block/by-name/misc          flags=display="Misc"
/seccfg        emmc    /dev/block/by-name/seccfg        flags=display="SecCfg";backup=1
/logo          emmc    /dev/block/by-name/logo          flags=display="Logo";backup=1;flashimg=1
/lk            emmc    /dev/block/by-name/lk            flags=display="Bootloader (lk)";backup=1;slotselect

# --- Removable storage (SD slot: msdc1 @ 11240000 per stock fstab) ---
/external_sd   auto    /dev/block/mmcblk1p1  /dev/block/mmcblk1   flags=display="MicroSD";storage;wipeingui;removable
