#!/system/bin/sh

if [ "$1" = "delete" ] && [ "$2" = "userdata" ]; then
    list=""
    while read dev mp rest; do
        case "$dev" in
            /dev/block/dm-*|/dev/block/mapper/userdata) list="$mp $list" ;;
        esac
    done < /proc/mounts

    for mp in $list /data/user/0 /data/media/0 /data; do
        umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null
    done
    sync
fi
exec /system/bin/dmctl "$@"
