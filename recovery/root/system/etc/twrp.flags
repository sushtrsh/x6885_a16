# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#
# mount point        fs     device                                       device2                flags

# User writeable partitions
/boot                  emmc   /dev/block/by-name/boot                                             flags=display=boot;slotselect;backup;flashimg
/vendor_boot           emmc   /dev/block/by-name/vendor_boot                                      flags=display=vendor_boot;slotselect;backup;flashimg
/vbmeta                emmc   /dev/block/by-name/vbmeta                                           flags=display=vbmeta;slotselect;backup;flashimg
/vbmeta_system         emmc   /dev/block/by-name/vbmeta_system                                    flags=display=vbmeta_system;slotselect;backup;flashimg
/vbmeta_vendor         emmc   /dev/block/by-name/vbmeta_vendor                                    flags=display=vbmeta_vendor;slotselect;backup;flashimg
/init_boot             emmc   /dev/block/by-name/init_boot                                        flags=display=init_boot;slotselect;backup;flashimg

# Firmware
/dtbo                  emmc   /dev/block/by-name/dtbo                                             flags=display=dtbo;slotselect;backup
/metadata              ext4   /dev/block/by-name/metadata                                         flags=display=metadata;backup
/misc                  emmc   /dev/block/by-name/misc                                             flags=display=misc;backup

# Sensitive Data
/nvcfg                 ext4   /dev/block/by-name/nvcfg                                            flags=display=nvcfg;backup
/persist_image         emmc   /dev/block/by-name/persist                                          flags=display=persist;backup
/persistent            emmc   /dev/block/by-name/frp                                              flags=display=persistent;backup

# IMEI and modem related
/nvdata                ext4   /dev/block/by-name/nvdata                                           flags=display=nvdata;backup
/protect_f             ext4   /dev/block/by-name/protect1                                         flags=display=protect_f;backup
/protect_s             ext4   /dev/block/by-name/protect2                                         flags=display=protect_s;backup
/nvram                 emmc   /dev/block/by-name/nvram                                            flags=display=nvram;backup

# Standard MediaTek's partitions
/expdb                 emmc   /dev/block/by-name/expdb                                            flags=display=expdb
/logo                  emmc   /dev/block/by-name/logo                                             flags=display=logo;slotselect;backup
/lk                    emmc   /dev/block/by-name/lk                                               flags=display=lk;slotselect;backup;flashimg
/mcupm                 emmc   /dev/block/by-name/mcupm                                            flags=display=mcupm;slotselect;backup;flashimg
/pi_img                emmc   /dev/block/by-name/pi_img                                           flags=display=pi_img;slotselect;backup;flashimg
/md1img                emmc   /dev/block/by-name/md1img                                           flags=display=md1img;slotselect;backup;flashimg
/otp                   emmc   /dev/block/by-name/otp                                              flags=display=otp
/seccfg                emmc   /dev/block/by-name/seccfg                                           flags=display=seccfg
/spmfw                 emmc   /dev/block/by-name/spmfw                                            flags=display=spmfw;slotselect
/tee                   emmc   /dev/block/by-name/tee                                              flags=display=tee;slotselect;backup

# Removable storage
/external_sd           auto   /dev/block/mmcblk0p1                         /dev/block/mmcblk1p1   flags=display=Micro_SD_Card;storage;wipeingui;removable;backup=0
/usb-otg               auto   /dev/block/sdd                               /dev/block/sdd1        flags=display=USB-OTG;storage;wipeingui;removable;backup=0

# Flashable logical partitions
/system_image          emmc   /dev/block/bootdevice/by-name/system                                flags=display=system;backup;flashimg
/vendor_image          emmc   /dev/block/bootdevice/by-name/vendor                                flags=display=vendor;backup;flashimg
/system_ext_image      emmc   /dev/block/bootdevice/by-name/system_ext                            flags=display=system_ext;backup;flashimg
/product_image         emmc   /dev/block/bootdevice/by-name/product                               flags=display=product;backup;flashimg
/vendor_dlkm_image     emmc   /dev/block/bootdevice/by-name/vendor_dlkm                           flags=display=vendor_dlkm;backup;flashimg
/odm_dlkm_image        emmc   /dev/block/bootdevice/by-name/odm_dlkm                              flags=display=odm_dlkm;backup;flashimg
/tr_carrier_image      emmc   /dev/block/bootdevice/by-name/tr_carrier                            flags=display=tr_carrier;backup;flashimg
/tr_company_image      emmc   /dev/block/bootdevice/by-name/tr_company                            flags=display=tr_company;backup;flashimg
/tr_overlayfs_image    emmc   /dev/block/bootdevice/by-name/tr_overlayfs                          flags=display=tr_overlayfs;backup;flashimg
/tr_preload_image      emmc   /dev/block/bootdevice/by-name/tr_preload                            flags=display=tr_preload;backup;flashimg
/tr_product_image      emmc   /dev/block/bootdevice/by-name/tr_product                            flags=display=tr_product;backup;flashimg
/tr_region_image       emmc   /dev/block/bootdevice/by-name/tr_region                             flags=display=tr_region;backup;flashimg
/tr_misc_image         emmc   /dev/block/bootdevice/by-name/tr_misc                               flags=display=tr_misc;backup;flashimg
/tr_manifest_image     emmc   /dev/block/bootdevice/by-name/tr_manifest                           flags=display=tr_manifest;backup;flashimg
/odm_image             emmc   /dev/block/bootdevice/by-name/odm                                   flags=display=odm;backup;flashimg
/system_dlkm_image     emmc   /dev/block/bootdevice/by-name/system_dlkm                           flags=display=system_dlkm;backup;flashimg
